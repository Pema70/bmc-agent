# Skopiuj do pliku .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Kolejne zmienne (klucze LLM) dochodzą w kolejnych krokach.
# ANTHROPIC_API_KEY trzymaj tylko tutaj, nigdy jako zmienną systemową (patrz CLAUDE.md).

# Lokalny Postgres z docker-compose.yml (docker compose up -d db)
DATABASE_URL="postgresql://bmc:bmc@localhost:5433/bmc_dev?schema=public"

# Auth.js (next-auth v4). Sekret wygeneruj np.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Model LLM (src/lib/ai/models.ts). Zmiana modelu to zmiana tych zmiennych, nie kodu.
# Nazwy modeli sprawdzaj w dokumentacji dostawcy (modele bywają wycofywane).
# Dev: darmowy klucz Gemini z Google AI Studio. Na darmowym planie Google wykorzystuje treści
# do ulepszania produktów, więc wysyłaj wyłącznie dane przykładowe.
LLM_PROVIDER="google"
LLM_MODEL="gemini-3.8-flash"
GOOGLE_GENERATIVE_AI_API_KEY=""
# OpenAI i Anthropic: obsługa dochodzi w osobnych PR-ach.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Limity agenta (src/lib/ai/config.ts). Wartości poniżej to domyślne.
# MAX_STEPS: każdy krok to osobne zapytanie do API, a darmowy plan Gemini ma niskie limity.
MAX_STEPS=3
CHAT_MAX_REQUESTS_PER_HOUR=30
CHAT_MAX_TOKENS_PER_DAY=200000
LLM_MAX_OUTPUT_TOKENS=2000
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_HISTORY_LIMIT=30
MAX_PENDING_PROPOSALS=20
