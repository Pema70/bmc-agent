# Skopiuj do pliku .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Wszystkie zmienne aplikacji. Zmienne limitów (sekcja na dole) są opcjonalne: pusta lub pominięta daje wartość domyślną.
# ANTHROPIC_API_KEY trzymaj tylko tutaj, nigdy jako zmienną systemową (patrz CLAUDE.md).

# Lokalny Postgres z docker-compose.yml (docker compose up -d db)
DATABASE_URL="postgresql://bmc:bmc@localhost:5433/bmc_dev?schema=public"

# Auth.js (next-auth v4). Sekret wygeneruj np.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Model LLM (src/lib/ai/models.ts). Zmiana modelu to zmiana tych zmiennych, nie kodu.
# Nazwy modeli sprawdzaj w dokumentacji dostawcy (modele bywają wycofywane).
# Dev: darmowy klucz Gemini z Google AI Studio. Na darmowym planie Google wykorzystuje treści
# do ulepszania produktów, więc wysyłaj wyłącznie dane przykładowe.
LLM_PROVIDER="google"
LLM_MODEL="gemini-3.8-flash"
GOOGLE_GENERATIVE_AI_API_KEY=""
# Sędzia (niezależny agent oceniający, krok 10): osobny model z innej rodziny niż modele generujące (Gemini).
# Anthropic służy wyłącznie sędziemu: JUDGE_PROVIDER musi być "anthropic", a LLM_PROVIDER nie może nim być.
# Konfiguracja jest niezależna od LLM_PROVIDER i LLM_MODEL. Klucz z konsoli Anthropic (przedpłata bez automatycznego
# doładowania), tylko w tym pliku, nigdy jako zmienna systemowa.
JUDGE_PROVIDER="anthropic"
JUDGE_MODEL="claude-haiku-5-5"
ANTHROPIC_API_KEY=""
# Przycisk „Oceń sędzią” w interfejsie (od PR 10d); puste lub inna wartość niż "true" oznacza ukryty.
JUDGE_UI_ENABLED=""
# OpenAI nie jest obsługiwane: OPENAI_API_KEY jest NIEUŻYWANY, zostaw puste.
OPENAI_API_KEY=""

# Limity agenta (src/lib/ai/config.ts). Wartości poniżej to domyślne.
# MAX_STEPS: każdy krok to osobne zapytanie do API, a darmowy plan Gemini ma niskie limity.
MAX_STEPS=3
CHAT_MAX_REQUESTS_PER_HOUR=30
CHAT_MAX_TOKENS_PER_DAY=200000
LLM_MAX_OUTPUT_TOKENS=2000
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_HISTORY_LIMIT=30
MAX_PENDING_PROPOSALS=20
# Najwyżej tyle wariantów na projekt (kopie i zapisane strategie); usuwania wariantów jeszcze nie ma.
MAX_VARIANTS_PER_PROJECT=10
# Limit tokenów wyjścia dla operacji z dużym wynikiem (strategie, porównanie); osobny, żeby nie rozdymać czatu.
LLM_MAX_OUTPUT_TOKENS_LONG=12000
# Poziom myślenia modelu czatu (ogólne ustawienie reasoning AI SDK): none, minimal, low, medium, high, xhigh, max.
# Puste = domyślne myślenie modelu (tak działa aplikacja). Dotyczy tylko modelu czatu, nie sędziego. Dla pomiarów używa się
# argumentu --reasoning skryptu ewaluacji (nadpisuje tę zmienną w procesie skryptu).
LLM_REASONING=

# Załączniki (src/lib/attachments/config.ts). Wartości poniżej to domyślne.
# Najwyżej tyle bajtów na jeden plik (10 MB).
ATTACHMENT_MAX_BYTES=10485760
# Najwyżej tyle załączników na projekt.
ATTACHMENT_MAX_PER_PROJECT=10
# Najwyżej tyle znaków wyekstrahowanego tekstu zapisujemy w bazie (dalej przycięcie).
ATTACHMENT_MAX_TEXT_CHARS=200000
# Najwyżej tyle znaków tekstu zwraca jedno wywołanie narzędzia read_attachment.
READ_ATTACHMENT_MAX_CHARS=6000
# Ekstrakcja tekstu: łączny rozmiar plików w DOCX po rozpakowaniu (bajty), liczba plików w DOCX,
# liczba stron PDF i limit czasu ekstrakcji (ms).
ATTACHMENT_ZIP_MAX_UNCOMPRESSED_BYTES=104857600
ATTACHMENT_ZIP_MAX_ENTRIES=1000
ATTACHMENT_PDF_MAX_PAGES=200
ATTACHMENT_EXTRACT_TIMEOUT_MS=15000
# Katalog magazynu plików na dev (poza repozytorium, jest w .gitignore).
ATTACHMENTS_DIR=".data/attachments"
