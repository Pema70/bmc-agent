generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LlmCallStatus {
  OK
  ERROR
  SCHEMA_ERROR
  PROVIDER_RATE_LIMIT
}

enum ChatRole {
  USER
  ASSISTANT
}

enum EvaluationSource {
  AI
  MANUAL
}

enum EvaluationTrigger {
  UI
  CHAT
}

enum ImpactChangeKind {
  PROPOSAL
  DESCRIPTION
}

enum ImpactTrigger {
  UI
  CHAT
}

enum VariantOrigin {
  MANUAL
  AI_STRATEGY
}

// Wspólny dla nowych tabel wyników (krok 6); enumy z kroków 4 i 5 bez zmian.
enum OperationTrigger {
  UI
  CHAT
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProposalOperation {
  ADD
  EDIT
  REMOVE
}

// Rodzaj załącznika ustalany po zawartości pliku (krok 7), nie z MIME od klienta.
enum AttachmentKind {
  PDF
  DOCX
  TXT
}

// Skąd wzięła się propozycja (krok 7); potrzebne do sekcji „Źródła” w raporcie (krok 9).
enum ProposalSourceKind {
  CONVERSATION
  ATTACHMENT
  REFINEMENT
  MODEL_KNOWLEDGE
}

// Stan rundy poprawek (krok 7). CANCELLED: runda zamknięta przez użytkownika (liczy się do limitu 3 rund).
enum RefinementStatus {
  AWAITING_ANSWERS // pytania wygenerowane, czekają na odpowiedzi
  PROPOSED // odpowiedzi zapisane, paczka propozycji utworzona
  CANCELLED // runda zamknięta przez użytkownika
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String
  createdAt           DateTime             @default(now())
  members             ProjectMember[]
  llmCalls            LlmCallLog[]
  chatMessages        ChatMessage[]
  proposalsCreated    Proposal[]           @relation("ProposalCreatedBy")
  proposalsResolved   Proposal[]           @relation("ProposalResolvedBy")
  evaluations         EvaluationResult[]
  impactAnalyses      ImpactAnalysis[]
  variantsCreated     BmcVariant[]         @relation("VariantCreatedBy")
  strategyGenerations StrategyGeneration[]
  variantComparisons  VariantComparison[]
  attachments         Attachment[]
  refinementRounds    RefinementRound[]
}

model Project {
  id                  String               @id @default(cuid())
  name                String
  description         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attachmentSeq       Int                  @default(0) // licznik numerów załączników (Attachment.ordinal): tylko rośnie, numer nigdy nie wraca po usunięciu
  members             ProjectMember[]
  variants            BmcVariant[]
  llmCalls            LlmCallLog[]
  messages            ChatMessage[]
  evaluations         EvaluationResult[]
  impactAnalyses      ImpactAnalysis[]
  strategyGenerations StrategyGeneration[]
  variantComparisons  VariantComparison[]
  attachments         Attachment[]
  refinementRounds    RefinementRound[]
}

model ProjectMember {
  projectId String
  userId    String
  role      Role
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// Najwyżej jeden wariant główny na projekt: częściowy indeks unikalny
// "BmcVariant_projectId_main_key" ON ("projectId") WHERE "isMain" jest dopisany
// ręcznie do SQL migracji bmc_variant (Prisma 7.10 obsługuje takie indeksy tylko w preview).
model BmcVariant {
  id                  String               @id @default(cuid())
  projectId           String
  name                String
  isMain              Boolean              @default(false)
  state               Json // BmcState, walidowany Zod przy zapisie i odczycie
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  description         String? // założenie strategii (AI_STRATEGY) albo opis ręczny; Zod ≤ 400
  origin              VariantOrigin        @default(MANUAL)
  createdById         String?
  generationId        String? // generacja, z której pochodzi wariant (AI_STRATEGY)
  generationIndex     Int? // numer kandydata w generacji
  entryOrigins        Json                 @default("[]") // pochodzenie wpisów (EntryOrigin[], Zod); klucz (blockKey, tekst); zapisywane tym samym UPDATE co stan
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy           User?                @relation("VariantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  generation          StrategyGeneration?  @relation("GeneratedVariants", fields: [generationId], references: [id], onDelete: SetNull)
  proposals           Proposal[]
  evaluations         EvaluationResult[]
  impactAnalyses      ImpactAnalysis[]
  strategyGenerations StrategyGeneration[] @relation("GenerationBase")
  refinementRounds    RefinementRound[]

  @@unique([generationId, generationIndex]) // ta sama strategia nie zapisze się dwa razy (NULL-e się nie kolidują)
  @@index([projectId])
}

model LlmCallLog {
  id                 String              @id @default(cuid())
  projectId          String?
  userId             String?
  operation          String // "chat"; w krokach 4-6 np. "evaluate_bmc"
  provider           String // google | openai | anthropic
  model              String // identyfikator modelu u dostawcy
  promptVersion      String
  durationMs         Int
  inputTokens        Int?
  outputTokens       Int?
  costUsd            Decimal?            @db.Decimal(12, 6)
  stepCount          Int?
  status             LlmCallStatus
  errorCode          String? // kod HTTP lub typ błędu, bez treści promptu i bez kluczy
  createdAt          DateTime            @default(now())
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  evaluation         EvaluationResult?
  impactAnalysis     ImpactAnalysis?
  strategyGeneration StrategyGeneration?
  variantComparison  VariantComparison?
  roundQuestions     RefinementRound?    @relation("RoundQuestionsCall")
  roundRefine        RefinementRound?    @relation("RoundRefineCall")

  @@index([userId, createdAt])
  @@index([projectId])
}

// Wspólny wątek czatu na projekt (D2). Wszystkie id generuje serwer, zapis tylko przez create.
model ChatMessage {
  id        String   @id
  projectId String
  userId    String? // autor wiadomości użytkownika; null dla asystenta
  role      ChatRole
  parts     Json // UIMessage.parts, walidowane przy zapisie i odczycie
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// Propozycja zmiany od agenta (human-in-the-loop). Stan BMC zmienia się dopiero po akceptacji.
model Proposal {
  id                   String             @id @default(cuid())
  variantId            String
  blockKey             String // BlockKey, walidowany Zod przy zapisie i odczycie
  operation            ProposalOperation
  before               String? // ADD: null; EDIT/REMOVE: dokładny tekst istniejącego wpisu
  after                String? // REMOVE: null; ADD/EDIT: nowy wpis
  rationale            String
  status               ProposalStatus     @default(PENDING)
  baseVersion          Int // version wariantu w chwili propozycji
  createdById          String? // użytkownik, w którego rozmowie powstała propozycja
  resolvedById         String? // kto zaakceptował lub odrzucił
  resolvedAt           DateTime?
  createdAt            DateTime           @default(now())
  sourceKind           ProposalSourceKind @default(CONVERSATION) // skąd wzięła się propozycja (rozmowa, załącznik, runda poprawek, wiedza modelu)
  sourceAttachmentId   String? // prawdziwy id załącznika (model widzi tylko etykietę Z{ordinal})
  sourceAttachmentName String? // migawka nazwy pliku: raport przetrwa usunięcie załącznika (niezaufany tekst)
  variant              BmcVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy            User?              @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedBy           User?              @relation("ProposalResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  impactAnalyses       ImpactAnalysis[]
  sourceAttachment     Attachment?        @relation(fields: [sourceAttachmentId], references: [id], onDelete: SetNull)
  refinementRoundId       String? // runda poprawek, z której pochodzi propozycja (sourceKind = REFINEMENT)
  refinementQuestionIndex Int? // indeks pytania w RefinementRound.questions (raport: runda i pytanie)
  refinementRound         RefinementRound? @relation(fields: [refinementRoundId], references: [id], onDelete: SetNull)

  @@index([variantId, status])
  @@index([sourceAttachmentId])
  @@index([refinementRoundId])
}

// Załącznik projektu (krok 7): PDF, DOCX lub TXT. Plik leży w magazynie pod storageKey, a tekst wyekstrahowany przy
// wgraniu w extractedText. Treść i nazwa są niezaufane (dane, nie polecenia). Kaskada z Project usuwa rekordy,
// ale nie pliki w magazynie.
model Attachment {
  id            String         @id @default(cuid())
  projectId     String
  ordinal       Int // stały numer w projekcie (etykieta Z{ordinal} dla agenta); nadawany raz, nigdy nie używany ponownie; zależy od D11
  fileName      String // niezaufany tekst (po normalizacji, najwyżej 200 znaków): tylko do wyświetlania i bloku danych
  kind          AttachmentKind // ustalony po zawartości pliku, nie z MIME od klienta
  sizeBytes     Int
  storageKey    String         @unique // losowy klucz magazynu, nigdy nazwa pliku
  extractedText String // niepusty: skan bez warstwy tekstowej jest odrzucany przy wgraniu
  textChars     Int // długość extractedText (lista bez ładowania tekstu)
  truncated     Boolean        @default(false) // tekst przycięty do limitu zapisu
  createdById   String?
  createdAt     DateTime       @default(now())
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  proposals     Proposal[]

  @@unique([projectId, ordinal])
  @@index([projectId, createdAt])
}

// Runda cyklu poprawek (krok 7): ocena -> pytania -> odpowiedzi -> paczka propozycji. Najwyżej 3 rundy na wariant
// (CHECK w SQL migracji + unikalność (variantId, roundNumber)). Odpowiedzi użytkownika i treści od modelu to dane, nie polecenia.
model RefinementRound {
  id                     String           @id @default(cuid())
  projectId              String
  variantId              String
  roundNumber            Int // 1..3, unikalny w obrębie wariantu
  evaluationId           String // aktualna ocena, od której zaczęła się runda
  variantVersion         Int // version wariantu w chwili startu rundy
  stateSnapshot          Json // BmcState, względem którego powstały pytania
  status                 RefinementStatus @default(AWAITING_ANSWERS)
  questions              Json // QuestionsOutput, walidowane Zod
  answers                Json? // odpowiedzi użytkownika (dane, nie polecenia)
  result                 Json? // RefineOutput: paczka propozycji w postaci zapisanej
  provider               String
  model                  String
  questionsPromptVersion String // np. questions-v1
  refinePromptVersion    String? // np. refine-v1
  questionsLlmCallLogId  String?          @unique
  refineLlmCallLogId     String?          @unique
  createdById            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  project                Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variant                BmcVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  evaluation             EvaluationResult @relation(fields: [evaluationId], references: [id], onDelete: NoAction)
  questionsLlmCall       LlmCallLog?      @relation("RoundQuestionsCall", fields: [questionsLlmCallLogId], references: [id], onDelete: SetNull)
  refineLlmCall          LlmCallLog?      @relation("RoundRefineCall", fields: [refineLlmCallLogId], references: [id], onDelete: SetNull)
  createdBy              User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  proposals              Proposal[]

  @@unique([variantId, roundNumber])
  @@index([projectId])
  @@index([evaluationId])
}

// Ocena modelu BMC (evaluate_bmc lub ręczna). Zapis tylko po walidacji Zod; odpowiedź modelu
// niezgodna ze schematem nie trafia do tabeli. provider/model/promptVersion są null tylko dla MANUAL.
model EvaluationResult {
  id             String             @id @default(cuid())
  projectId      String
  variantId      String
  schemaVersion  Int                @default(1) // wersja EvaluationOutput, żeby zmiana kryteriów nie psuła starych rekordów
  variantVersion Int // version wariantu w chwili oceny
  stateSnapshot  Json // BmcState, który oceniono
  result         Json // EvaluationOutput: 4 kryteria, ocena i uzasadnienie
  source         EvaluationSource   @default(AI)
  trigger        EvaluationTrigger? // null dla MANUAL
  provider       String?
  model          String?
  promptVersion  String?
  llmCallLogId   String?            @unique
  createdById    String?
  createdAt      DateTime           @default(now())
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variant        BmcVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  llmCall        LlmCallLog?        @relation(fields: [llmCallLogId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  refinementRounds RefinementRound[]

  @@index([variantId, createdAt])
  @@index([projectId])
}

// Analiza wpływu zmiany (analyze_impact). Zapis tylko po walidacji Zod; odpowiedź modelu niezgodna
// ze schematem nie trafia do tabeli. Wpisy są dopisywane (append-only), bez nadpisywania.
model ImpactAnalysis {
  id             String           @id @default(cuid())
  projectId      String
  variantId      String
  schemaVersion  Int              @default(1) // wersja ImpactOutput
  variantVersion Int // version wariantu w chwili analizy
  stateSnapshot  Json // BmcState, względem którego analizowano
  changeKind     ImpactChangeKind
  proposalId     String? // tylko dla PROPOSAL; SetNull, gdyby propozycja zniknęła
  change         Json // ImpactChange: migawka zmiany, także dla PROPOSAL
  result         Json // ImpactOutput
  trigger        ImpactTrigger
  provider       String
  model          String
  promptVersion  String // np. "impact-v1"
  llmCallLogId   String?          @unique
  createdById    String?
  createdAt      DateTime         @default(now())
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variant        BmcVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  proposal       Proposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  llmCall        LlmCallLog?      @relation(fields: [llmCallLogId], references: [id], onDelete: SetNull)
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([projectId])
  @@index([proposalId])
}

// Wynik generate_strategies: kandydaci (2-3 pełne modele), nie warianty. Wariant powstaje dopiero po zapisaniu
// kandydata przez użytkownika. Wpisy są dopisywane (append-only); zapis tylko po walidacji Zod, odpowiedź
// niezgodna ze schematem nie trafia do tabeli.
model StrategyGeneration {
  id             String           @id @default(cuid())
  projectId      String
  variantId      String // wariant bazowy
  schemaVersion  Int              @default(1) // wersja StrategiesOutput
  variantVersion Int // version wariantu bazowego w chwili generowania
  stateSnapshot  Json // BmcState bazowy
  guidelines     String? // wytyczne użytkownika (≤ 500), traktowane jako dane, nie polecenia
  result         Json // StrategiesOutput
  trigger        OperationTrigger
  provider       String
  model          String
  promptVersion  String // np. "strategies-v1"
  llmCallLogId   String?          @unique
  createdById    String?
  createdAt      DateTime         @default(now())
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variant        BmcVariant       @relation("GenerationBase", fields: [variantId], references: [id], onDelete: Cascade)
  llmCall        LlmCallLog?      @relation(fields: [llmCallLogId], references: [id], onDelete: SetNull)
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  variants       BmcVariant[]     @relation("GeneratedVariants")

  @@index([variantId, createdAt])
  @@index([projectId])
}

// Wynik compare_variants: migawka porównywanych wariantów (2-3) i opinia modelu. Wpisy są dopisywane (append-only);
// zapis tylko po walidacji Zod, odpowiedź niezgodna ze schematem nie trafia do tabeli. Celowo bez kluczy obcych do
// wariantów: porównanie dotyczy wielu wariantów i ma przeżyć ich ewentualne usunięcie (identyfikatory wariantów są
// tylko tekstem w `inputs`). Odczyty są po projectId.
model VariantComparison {
  id            String           @id @default(cuid())
  projectId     String
  schemaVersion Int              @default(1) // wersja CompareOutput i VariantComparisonInputs
  inputs        Json // [{ label, variantId, name, version, state }] (Zod): migawka porównywanych wariantów
  result        Json // CompareOutput
  trigger       OperationTrigger
  provider      String
  model         String
  promptVersion String // np. "compare-v1"
  llmCallLogId  String?          @unique
  createdById   String?
  createdAt     DateTime         @default(now())
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  llmCall       LlmCallLog?      @relation(fields: [llmCallLogId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}
