generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  passwordHash String
  createdAt    DateTime        @default(now())
  members      ProjectMember[]
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  variants    BmcVariant[]
}

model ProjectMember {
  projectId String
  userId    String
  role      Role
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

// Najwyżej jeden wariant główny na projekt: częściowy indeks unikalny
// "BmcVariant_projectId_main_key" ON ("projectId") WHERE "isMain" jest dopisany
// ręcznie do SQL migracji bmc_variant (Prisma 7.10 obsługuje takie indeksy tylko w preview).
model BmcVariant {
  id        String   @id @default(cuid())
  projectId String
  name      String
  isMain    Boolean  @default(false)
  state     Json // BmcState, walidowany Zod przy zapisie i odczycie
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
